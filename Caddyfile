{$PUBLIC_BASE_URL} {
	encode zstd gzip

	reverse_proxy backend:3000 {
		health_uri /health
		health_interval 10s
		health_timeout 3s
	}

	log {
		output stdout
		format json
	}
}

# Anything else on plain HTTP (the bare IP, unknown hosts) belongs to the other stack on this
# VM, which used to sit behind the host's nginx until Caddy took over ports 80 and 443.
:80 {
	reverse_proxy {$FALLBACK_UPSTREAM:host.docker.internal:8080}
}
