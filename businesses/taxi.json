{
  "schema_version": 1,
  "id": "taxi",
  "name": "מוניות קלורה",
  "language": "he-IL",
  "timezone": "Asia/Jerusalem",
  "phone_numbers": [],
  "phone_numbers_env": "TAXI_PHONE_NUMBERS",

  "voice": {
    "provider": "elevenlabs",
    "voice_id_env": "ELEVENLABS_VOICE_ID",
    "library_model": "eleven_v3",
    "dynamic_model": "eleven_v3",
    "personality": ["צעיר", "ישראלי", "חברי", "מהיר", "ישיר", "לא פורמלי מדי", "רגוע", "יעיל"],
    "settings": { "stability": 0.5, "similarity_boost": 0.75, "style": 0.0, "speed": 1.0 },
    "deliveries": {
      "normal": {},
      "quick": { "speed": 1.08 },
      "calm": { "speed": 0.93, "stability": 1.0 },
      "important": { "speed": 0.92 },
      "slow": { "speed": 0.85, "pregenerate": true }
    },
    "dynamic_cover": "tts_cover"
  },

  "greeting": "greeting",
  "anything_else": "anything_else",
  "goodbye": "goodbye",
  "confirm_slot": "confirm_value",
  "acknowledgement": "ack",

  "lexicon": {
    "affirm": ["כן", "כן כן", "בטח", "סבבה", "יאללה", "נכון", "אוקיי", "אוקי", "בדיוק", "מאשר", "תשלח", "שלח", "יופי", "מעולה", "בסדר", "כן תשלח", "נכון מאוד", "yes"],
    "deny": ["לא", "לא לא", "ממש לא", "אל תשלח", "לא נכון", "no"],
    "fillers": ["אה", "אממ", "אמ", "אהה", "אהמ", "כאילו", "בעצם", "בבקשה", "לי", "לנו", "טוב", "שמע", "תשמע", "אחי", "אחותי", "מותק", "צריך", "רוצה", "אני", "היי", "הלו", "שלום", "אהלן", "תודה", "רבה"],
    "now": ["עכשיו", "כמה שיותר מהר", "מיד", "כרגע", "דחוף", "בהקדם", "עכשיו עכשיו", "הכי מהר"]
  },

  "meta_intents": {
    "repeat_last": {
      "exact": ["מה", "מה אמרת", "סליחה", "תחזור", "עוד פעם", "שוב", "אפשר שוב"],
      "phrases": ["תחזור על זה", "תגיד שוב", "תגיד עוד פעם", "אפשר לחזור על זה", "מה אמרת", "מה שאמרת", "מה אמרת לי"]
    },
    "did_not_understand": {
      "exact": ["לא הבנתי", "לא שמעתי", "לא הבנתי אותך", "לא שמעתי טוב", "לא הבנתי מה אמרת"]
    },
    "speak_slower": { "phrases": ["יותר לאט", "לאט יותר", "תדבר לאט", "דבר לאט", "לאט לאט"] },
    "speak_louder": { "phrases": ["יותר חזק", "לא שומע אותך", "לא שומעת אותך", "תדבר חזק", "דבר חזק", "תדבר יותר חזק"] },
    "cancel_current_flow": {
      "exact": ["עזוב", "עזוב תבטל", "תבטל", "בטל", "לא משנה", "עזוב את זה", "לא צריך", "תשכח מזה", "עזוב לא צריך"],
      "response": "flow_cancelled"
    },
    "go_back": {
      "phrases": ["רגע טעיתי", "טעיתי", "תחזור אחורה", "רגע חזור"],
      "response": "go_back"
    },
    "transfer_human": {
      "phrases": ["נציג", "נציגה", "מוקדן", "מוקדנית", "בן אדם", "נציג אנושי", "לדבר עם מישהו", "לדבר עם בן אדם"]
    },
    "goodbye": {
      "exact": ["ביי", "להתראות", "תודה ביי", "יאללה ביי", "זהו תודה", "זה הכל", "זהו", "תודה זהו", "ביי ביי", "זהו זה"],
      "response": "goodbye"
    },
    "wait": { "exact": ["רגע", "שנייה", "רק רגע", "חכה", "רגע רגע", "לא לא רגע", "שנייה אחת", "רגע אחד"] }
  },

  "intents": [
    {
      "id": "book_ride",
      "description": "הזמנת מונית",
      "keywords": ["מונית", "טקסי", "להזמין", "תזמין", "הסעה", "תשלח", "לשלוח", "נהג"],
      "examples": ["צריך מונית עכשיו מרבי עקיבא 12 לנתב\"ג, אנחנו ארבעה", "תשלח לי מונית לתל השומר", "אפשר להזמין מונית לעוד חצי שעה?"],
      "pipeline": "book_ride"
    },
    {
      "id": "ride_status",
      "description": "בירור סטטוס נסיעה קיימת",
      "keywords": ["איפה הנהג", "איפה המונית", "מתי מגיע", "מתי הוא מגיע", "מתי הנהג", "כמה זמן עוד", "מתי יגיע", "הנהג בדרך", "עוד לא הגיע"],
      "examples": ["איפה הנהג שלי?", "הזמנתי מונית והיא עוד לא הגיעה"],
      "pipeline": "ride_status"
    },
    {
      "id": "cancel_ride",
      "description": "ביטול נסיעה שהוזמנה",
      "keywords": ["לבטל את הנסיעה", "תבטל את הנסיעה", "לבטל את המונית", "תבטל את המונית", "ביטול נסיעה", "לבטל את ההזמנה", "תבטל את ההזמנה"],
      "examples": ["אני רוצה לבטל את המונית שהזמנתי"],
      "pipeline": "cancel_ride",
      "switch_confidence": 0.7
    },
    {
      "id": "price_question",
      "description": "שאלת מחיר לנסיעה",
      "keywords": ["כמה עולה", "כמה זה עולה", "מחיר", "המחיר", "כמה יעלה", "כמה זה יוצא", "כמה יוצא"],
      "examples": ["כמה עולה נסיעה לנתב\"ג?"],
      "pipeline": "price_question"
    },
    {
      "id": "lost_item",
      "description": "דיווח על אבדה במונית",
      "keywords": ["שכחתי", "השארתי", "איבדתי", "אבדה", "אבד לי"],
      "examples": ["השארתי תיק במונית שהייתה אצלי לפני שעה"],
      "pipeline": "lost_item"
    },
    {
      "id": "complaint",
      "description": "תלונה על נסיעה או נהג",
      "keywords": ["תלונה", "להתלונן", "חצוף", "לא בסדר"],
      "examples": ["אני רוצה להגיש תלונה על הנהג"],
      "handoff": true
    },
    {
      "id": "driver_contact",
      "description": "יצירת קשר עם הנהג",
      "keywords": ["לדבר עם הנהג", "המספר של הנהג", "הטלפון של הנהג", "קשר עם הנהג"],
      "handoff": true
    },
    {
      "id": "small_talk",
      "description": "ברכה או שיחת חולין בלי בקשה (מה המצב, מה נשמע)",
      "keywords": ["מה המצב", "מה נשמע", "מה שלומך", "מה העניינים", "מה איתך", "מה הולך"],
      "examples": ["היי מה המצב?", "מה נשמע אחי?"],
      "respond": "small_talk_answer"
    },
    {
      "id": "invoice",
      "description": "קבלה או חשבונית על נסיעה",
      "keywords": ["חשבונית", "קבלה"],
      "respond": "invoice_answer"
    },
    {
      "id": "business_hours",
      "description": "שעות פעילות",
      "keywords": ["שעות פעילות", "עד מתי אתם", "אתם פתוחים", "שעות"],
      "respond": "hours_answer"
    }
  ],

  "slots": {
    "pickup_time": {
      "type": "time",
      "description": "זמן איסוף",
      "priority": 5
    },
    "passengers": {
      "type": "integer",
      "description": "מספר נוסעים",
      "priority": 10,
      "min": 1,
      "max": 20,
      "patterns": [
        "(?:^| )(?:אנחנו|אנו|נהיה|נוסעים|נוסעות)(?: רק)? (?P<value>[^ _]+)",
        "(?:^| )(?P<value>[^ _]+) (?:נוסעים|נוסעות|אנשים|איש)"
      ],
      "synonyms": { "לבד": 1, "רק אני": 1, "זוג": 2, "אני ואשתי": 2, "אני ובעלי": 2 }
    },
    "luggage": {
      "type": "integer",
      "description": "מזוודות",
      "priority": 11,
      "min": 0,
      "max": 10,
      "patterns": [
        "(?:^| )(?P<value>[^ _]+) (?:מזוודות|תיקים|מזוודות גדולות)",
        "(?:^| )(?:מזוודה|תיק) (?P<value>אחת|אחד)"
      ],
      "synonyms": { "בלי מזוודות": 0, "בלי תיקים": 0 }
    },
    "wheelchair": {
      "type": "boolean",
      "description": "נגישות לכיסא גלגלים",
      "priority": 12,
      "patterns": ["(?P<value>כיסא גלגלים|כסא גלגלים|כסא נכים|כיסא נכים)"]
    },
    "child_seat": {
      "type": "boolean",
      "description": "כיסא בטיחות לילד",
      "priority": 12,
      "patterns": ["(?P<value>כיסא לתינוק|כסא לתינוק|בוסטר|כיסא בטיחות|כסא בטיחות)"]
    },
    "vehicle": {
      "type": "enum",
      "description": "סוג רכב",
      "priority": 13,
      "values": { "standard": ["מונית רגילה"], "van": ["ואן", "מיניבוס", "מונית גדולה"] }
    },
    "pickup": {
      "type": "place",
      "description": "כתובת איסוף",
      "precise": true,
      "priority": 40,
      "patterns": [
        "(?:^| )(?:לאסוף|תאסוף|תאספו|איסוף|אוספים)(?: אותי| אותנו)? (?:מ|ב)?(?P<value>[^ _]{2,}(?: [^ _]+)*?)(?: ל[^ _]| _|$)",
        "(?:^| )מ(?P<value>[^ _]{2,}(?: [^ _]+)*?)(?: ל[^ _]| _|$)"
      ],
      "strip_prefixes": ["מה", "מ"],
      "context_aliases": { "מהבית": "home", "מהעבודה": "work", "מהמקום הרגיל": "usual" },
      "confirm_below": 0.6
    },
    "destination": {
      "type": "place",
      "description": "יעד",
      "street_once": true,
      "priority": 41,
      "patterns": [
        "(?:^| )(?:ל|אל |עד )(?P<value>[^ _]{2,}(?: [^ _]+)*?)(?: מ[^ _]| _|$)"
      ],
      "strip_prefixes": ["ל"],
      "context_aliases": { "הביתה": "home", "לבית": "home", "לעבודה": "work" },
      "confirm_below": 0.6
    },
    "customer_name": {
      "type": "text",
      "description": "שם הנוסע",
      "priority": 89
    },
    "notes": {
      "type": "text",
      "description": "הערות לנהג",
      "priority": 90
    },
    "item": {
      "type": "text",
      "description": "החפץ שנשכח",
      "priority": 30,
      "patterns": ["(?:^| )(?:שכחתי|השארתי|איבדתי)(?: את)? (?P<value>[^ _]+(?: [^ _]+)*?)(?: במונית| באוטו| ברכב| _|$)"]
    },
    "ride_time": {
      "type": "text",
      "description": "מתי הייתה הנסיעה",
      "priority": 31,
      "patterns": ["(?P<value>(?:לפני|אתמול|היום|הבוקר|בלילה)(?: [^ _]+)?)"]
    }
  },

  "agent": {
    "persona": "אתה המוקדן של מוניות קלורה: צעיר, ישראלי, חברי, מהיר, ישיר ורגוע. מדבר בגובה העיניים, בעברית מדוברת וקצרה, בלי שפה רשמית ובלי חזרות מיותרות. כל עוד לא ידוע אם המתקשר גבר או אישה, מדברים בניסוח ניטרלי (\"לאן נוסעים?\", \"לשלוח עכשיו?\"); צורת הפנייה מופיעה בכל תור (ADDRESS FORM). אף פעם לא שואלים אם המתקשר גבר או אישה.",
    "rules": [
      "Service area: all of Israel. Any Israeli city, street or landmark is a valid place.",
      "For a ride you need pickup, destination and the number of passengers; pickup time is now unless the caller says otherwise.",
      "Book a ride in this order, one short question per turn, skipping whatever the caller already said: 1. pickup city (\"סבבה, מאיזו עיר לאסוף?\"); 2. pickup street and number (\"איזה רחוב ומספר?\"); 3. destination city (\"לאיזו עיר נוסעים?\"); 4. destination street (\"לאיזה רחוב?\"): always ask it once when the destination so far is only a city, even if the caller gave pickup and destination together; only if they then say they do not know is the city enough; 5. passengers (\"כמה נוסעים?\"); 6. the name for the booking (\"על שם מי ההזמנה?\"; skip it if the system already knows the customer); 7. a note for the driver (\"יש משהו שהנהג צריך לדעת?\"; \"אין\" means none). Then read_back.",
      "Examples of the order: caller \"לבאר שבע\" (destination city, no street) → say \"לאיזה רחוב?\", not the passengers yet. Caller \"מרחוב הרצל 10 ברעננה לתל אביב\" → pickup is complete, the destination is only a city → say \"לאיזה רחוב?\". Caller \"לא יודע\" to that → the city is enough → say \"כמה נוסעים?\".",
      "Small talk together with a request gets one short answer that goes straight to the request: caller \"מה המצב? אני יכול להזמין מונית?\" → say \"סבבה, מאיזו עיר לאסוף?\" (never only \"הכל טוב\" when they asked for something).",
      "When the system did not accept a detail, ask for it again with the short question (\"כמה נוסעים?\"); do not explain the system's limits.",
      "Speech recognition splits and garbles words. Use your knowledge of real Israeli places and of Hebrew to fix obvious errors: in ירושלים, \"בני ינאי אומה\" or \"בניין ה-Human\" is \"בנייני האומה\"; \"ת\\\"מ איתן\", \"תמיטן\" or \"בתא מתן\" is \"תא מטען\" (the trunk); right after \"כמה נוסעים?\", the word \"שלום\" is \"שלוש\" (only that word; any other answer that is not a number, ask again). If you are not sure, ask.",
      "Pass a place's city as soon as it is said (\"אלעד\"), and its street with the city (\"בן זכאי 45, אלעד\").",
      "A place that is not a street (a building, a mall, a hospital, a school, a neighbourhood) is a fine answer to the street question: pass it with the city (\"בנייני האומה, ירושלים\"); the system knows the places of each city. If it says it does not know the place, ask \"יש כתובת של המקום?\"; if the caller does not know, pass the place again and go on.",
      "Every detail goes into fields in the turn it is said, never later. A landmark, building or business answers the street question: caller \"זה ליד התחנה המרכזית, לא זוכר את הרחוב\" → fields destination \"התחנה המרכזית, ירושלים\", then the next question. Only places the caller said.",
      "Anything the driver should know (a big trunk, a lot of luggage, a child seat, a wheelchair, \"call when you arrive\") is the note: pass it in notes (and luggage when a number of suitcases is said). One answer to the note question is enough: when nothing else is missing, read_back right away (never \"עוד משהו?\"). Never ask again for a detail that already has a value under CURRENT TASK.",
      "The answer to \"על שם מי ההזמנה?\" is the name: pass it in customer_name and go on (never ask for it twice). Speech recognition splits Hebrew names; write the real name it obviously is (\"בן-האיי או מנשה\" is \"בניהו מנשה\", \"יה או נתן כהן\" is \"יהונתן כהן\"), otherwise the name as heard.",
      "Only when the caller complains that they already told you (\"אמרתי לך כבר\"), say \"סליחה, צודק.\" and take the detail from the conversation. Never blame the line (\"הקו לא ברור\"): when you did not understand, ask the short question again.",
      "A correction after the read-back (\"לא 40, 45\") → pass the corrected detail with its city (\"בן זכאי 45, אלעד\") and action read_back; the system reads the whole ride again.",
      "Never repeat back what the caller just said as a question (\"בן זכאי 45 ברעננה, נכון?\"): go on to the next question; the read-back confirms everything.",
      "When the caller gives several details at once, take them all and ask only for what is still missing.",
      "A ride booked earlier in this call can be checked or cancelled with the matching task."
    ],
    "thinking_filler": "filler_hmm",
    "phrases": [
      "ack", "anything_else", "goodbye", "ask_change", "go_back", "fallback_1", "still_there",
      "ask_pickup", "ask_destination", "ask_passengers", "ask_item", "ask_ride_time", "small_talk_answer",
      "small_talk_short", "ask_pickup_city", "ask_pickup_street", "ask_destination_city", "ask_destination_street", "ask_name", "ask_notes",
      "filler_checking", "invoice_answer", "hours_answer", "cancel_declined"
    ]
  },

  "stt_keyterms": [
    "מונית", "נוסעים",
    "תל אביב", "רמת גן", "בני ברק", "גבעתיים", "חולון", "בת ים", "פתח תקווה", "ראשון לציון", "הרצליה", "רעננה",
    "כפר סבא", "הוד השרון", "נתניה", "ירושלים", "חיפה", "באר שבע", "אשדוד", "אשקלון", "רחובות", "נס ציונה",
    "מודיעין", "ראש העין", "אור יהודה", "יהוד", "קריית אונו", "גבעת שמואל", "לוד", "רמלה", "רמת השרון",
    "ז'בוטינסקי", "רוטשילד", "דיזנגוף", "אבן גבירול", "אלנבי", "הרצל", "ויצמן", "ביאליק",
    "ארלוזורוב", "קפלן", "רבי עקיבא", "דרך מנחם בגין", "תא מטען", "אלעד"
  ],

  "places": [
    { "name": "נתב״ג", "aliases": ["נתבג", "נמל התעופה", "שדה התעופה", "בן גוריון", "נמל התעופה בן גוריון", "השדה", "טרמינל 3"], "address": "נמל התעופה בן גוריון, טרמינל 3" },
    { "name": "עזריאלי", "aliases": ["מגדלי עזריאלי", "קניון עזריאלי", "עזריאלי תל אביב"], "address": "דרך מנחם בגין 132, תל אביב" },
    { "name": "תל השומר", "aliases": ["שיבא", "בית חולים שיבא", "בית החולים תל השומר"], "address": "המרכז הרפואי שיבא, רמת גן" },
    { "name": "תחנת רכבת בני ברק", "aliases": ["רכבת בני ברק", "התחנה בבני ברק"], "address": "תחנת רכבת בני ברק, ז'בוטינסקי, בני ברק" },
    { "name": "תחנה מרכזית", "aliases": ["התחנה המרכזית", "התחנה המרכזית החדשה"], "address": "התחנה המרכזית החדשה, לוינסקי 108, תל אביב" },
    { "name": "רכבת סבידור", "aliases": ["סבידור", "תל אביב מרכז", "רכבת מרכז", "תחנת רכבת מרכז"], "address": "תחנת רכבת תל אביב סבידור מרכז" }
  ],

  "pipelines": {
    "book_ride": {
      "description": "הזמנת מונית",
      "slots": [
        { "slot": "pickup", "required": true, "ask": "ask_pickup", "from_customer": "home" },
        { "slot": "destination", "required": true, "ask": "ask_destination" },
        { "slot": "pickup_time", "required": true, "default": "now" },
        { "slot": "passengers", "required": true, "ask": "ask_passengers" },
        { "slot": "customer_name", "ask": "ask_name" },
        { "slot": "luggage" },
        { "slot": "wheelchair" },
        { "slot": "child_seat" },
        { "slot": "vehicle" },
        { "slot": "notes", "ask": "ask_notes", "ask_before_confirm": true }
      ],
      "confirm": { "response": "confirm_ride", "ask_change": "ask_change" },
      "action": "create_ride",
      "filler": "filler_searching",
      "on_success": "ride_booked",
