# Callora V2 — local settings. Copy to `.env` (git-ignored) and fill in what you have.
# Names only are committed here; see SECRETS.md for what each one does. Every provider
# key is optional for development: missing ones degrade the service and are logged.

# Twilio (webhook signatures, hangup/transfer)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
STREAM_TOKEN_SECRET=
# The public HTTPS origin Twilio calls (e.g. an ngrok URL), no trailing slash.
PUBLIC_BASE_URL=

# Speech: Scribe (ElevenLabs) recognizes the caller; Cartesia is the backup.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
CARTESIA_API_KEY=

# The conversation agent (OpenAI). Defaults: gpt-6-sol, hedged by gpt-6-luna, reasoning none.
OPENAI_API_KEY=
AGENT_MODEL=
AGENT_BACKUP_MODEL=
AGENT_REASONING_EFFORT=
# Dollars per million tokens (input/cached/output), for the cost per call and the eval.
AGENT_PRICES=gpt-6-sol=2/0.2/10,gpt-6-luna=0.1/0.01/0.5
# Businesses without an agent: the rules, helped by Gemini and/or OpenAI.
GEMINI_API_KEY=

# Taxi business
TAXI_PHONE_NUMBERS=
TAXI_HANDOFF_NUMBER=
TAXI_DISPATCH_URL=
TAXI_DISPATCH_TOKEN=
TAXI_CRM_URL=
TAXI_CRM_TOKEN=

# Access
ALLOW_LIST=
ADMIN_API_KEY=
