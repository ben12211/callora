# Callora V2 — local settings. Copy to `.env` (git-ignored) and fill in what you have.
# Names only are committed here; see SECRETS.md for what each one does. Every provider
# key is optional for development: missing ones degrade the service and are logged.

# Twilio (webhook signatures, hangup/transfer)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
STREAM_TOKEN_SECRET=
# The public HTTPS origin Twilio calls (e.g. an ngrok URL), no trailing slash.
PUBLIC_BASE_URL=

# Speech: Deepgram Nova-3 recognizes the caller (STT_PROVIDER=scribe or cartesia to change).
# ElevenLabs also speaks, so its key is needed either way.
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
CARTESIA_API_KEY=

# The conversation agent. Default gemini-3.8-flash (GEMINI_API_KEY), hedged by gpt-6-luna
# (OPENAI_API_KEY). A gemini-* AGENT_MODEL goes to Gemini, anything else to OpenAI.
GEMINI_API_KEY=
OPENAI_API_KEY=
AGENT_MODEL=
AGENT_BACKUP_MODEL=
# Optional last resort after both agent models fail; "none" disables it.
AGENT_FALLBACK_MODEL=
AGENT_REASONING_EFFORT=
# Dollars per million tokens (input/cached/output), for the cost per call and the eval.
AGENT_PRICES=gpt-6-luna=0.1/0.01/0.5

# Taxi business
TAXI_PHONE_NUMBERS=
TAXI_HANDOFF_NUMBER=
TAXI_DISPATCH_URL=
TAXI_DISPATCH_TOKEN=
TAXI_CRM_URL=
TAXI_CRM_TOKEN=

# Access
ALLOW_LIST=
ADMIN_API_KEY=
