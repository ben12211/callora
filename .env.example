# Callora V2 — local settings. Copy to `.env` (git-ignored) and fill in what you have.
# Names only are committed here; see SECRETS.md for what each one does. Every provider
# key is optional for development: missing ones degrade the service and are logged.

# Twilio (webhook signatures, hangup/transfer)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
STREAM_TOKEN_SECRET=
# The public HTTPS origin Twilio calls (e.g. an ngrok URL), no trailing slash.
PUBLIC_BASE_URL=

# Speech
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPENAI_API_KEY=

# Taxi business
TAXI_PHONE_NUMBERS=
TAXI_HANDOFF_NUMBER=
TAXI_DISPATCH_URL=
TAXI_DISPATCH_TOKEN=
TAXI_CRM_URL=
TAXI_CRM_TOKEN=

# Access
ALLOW_LIST=
ADMIN_API_KEY=
