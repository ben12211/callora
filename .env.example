# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# PostgreSQL (the Docker Compose defaults match this value)
POSTGRES_USER=callora
POSTGRES_PASSWORD=callora
POSTGRES_DB=callora
DATABASE_URL=postgresql://callora:callora@localhost:5432/callora

# Twilio
# Use the Auth Token from the Twilio Console; never commit the real value.
# The Account SID is required: it authenticates the REST call that hangs calls up
# when the agent finishes a conversation. It must look like AC + 32 hex characters.
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
# The exact public origin Twilio calls, without a trailing slash (for example, an ngrok URL).
# Twilio Media Streams connect to wss://<this host>/webhooks/twilio/media, so it must be HTTPS in production.
PUBLIC_BASE_URL=https://your-public-host.example.com

# Control plane (dashboard at http://localhost:3000/dashboard)
# ADMIN_EMAIL and ADMIN_PASSWORD create the administrator on startup, and reset its
# password whenever this value changes. Leave both empty once the account exists and you
# manage the password from the dashboard instead.
ADMIN_EMAIL=admin@callora.local
ADMIN_PASSWORD=callora-dev-password
ADMIN_NAME=Callora Administrator
# Optional machine credential for the management API, sent as the X-Api-Key header.
# At least 16 characters. Dashboard users never see or need it.
ADMIN_API_KEY=
# How long a dashboard session stays signed in.
SESSION_TTL_HOURS=12

# Signs the short-lived token that authorises a Twilio Media Stream handshake. Optional:
# without it the Twilio auth token signs them, which is what Callora did before. Setting
# it separates the two credentials, so rotating the Twilio token no longer silently
# changes what a stream token means. Both are accepted while you introduce it, so no call
# in flight is dropped. At least 16 characters.
STREAM_TOKEN_SECRET=

# Encrypts the provider credentials entered in the dashboard (Providers page), which are
# stored in the database rather than here. At least 16 characters, and it must stay the
# same for the life of the deployment: changing it makes every stored credential
# unreadable and they have to be entered again. Leave it empty to keep managing
# credentials in this file only; the dashboard then still manages everything non-secret.
SECRETS_KEY=

# Everything from here down is the floor the dashboard can override. A value saved in the
# dashboard wins; clearing it there falls back to what is set here. Nothing below is
# required at startup any more — a deployment can come up with none of it and be
# configured in the browser, and until then calls answer with the business's greeting.

# Default realtime voice provider for newly created agents: openai (default),
# elevenlabs, or cartesia. Each business then chooses its own provider in the dashboard.
VOICE_PROVIDER=openai

# OpenAI Realtime — required when VOICE_PROVIDER=openai
# Server-side key used for the speech-to-speech call bridge; never commit the real value.
OPENAI_API_KEY=replace-with-your-openai-api-key
# Optional override of the realtime WebSocket endpoint.
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime
# Transcribes caller audio so live conversations show up in the logs. It never drives
# the reply; the model still hears the audio directly.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# ElevenLabs Agents — required when VOICE_PROVIDER=elevenlabs
# The agent must be configured for ulaw_8000 audio in and out, and must have the
# prompt, first message, and language overrides enabled under its Security tab.
ELEVENLABS_API_KEY=replace-with-your-elevenlabs-api-key
ELEVENLABS_AGENT_ID=replace-with-your-elevenlabs-agent-id
# Optional override of the ElevenLabs API origin.
ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io

# Set LOG_LEVEL=debug to also log the composed agent instructions once per call.

# Optional caller allowlist, also editable in the dashboard. When set to one or more
# E.164 numbers, only those callers reach the agent; everyone else is answered with a
# short message and hung up before any realtime session opens. Unset or empty allows
# every caller. Separate numbers with commas: ALLOW_LIST=+972501234567,+972509998888
ALLOW_LIST=

# Cartesia — required when VOICE_PROVIDER=cartesia
# Pipeline: Twilio -> Cartesia STT -> text LLM -> Cartesia Sonic TTS -> Twilio.
# Audio is mu-law 8 kHz end to end, so nothing is transcoded.
CARTESIA_API_KEY=replace-with-your-cartesia-api-key
# The Sonic voice UUID. Must suit the tenant language; Hebrew needs sonic-3 or 3.5.
CARTESIA_VOICE_ID=replace-with-your-cartesia-voice-id
# Optional overrides; the defaults are pinned, current model snapshots.
# CARTESIA_TTS_MODEL=sonic-3.5-2026-05-04
# ink-whisper is the multilingual STT model; ink-2 is faster but English-only.
# CARTESIA_STT_MODEL=ink-whisper
# CARTESIA_VERSION=2026-03-01

# Reasoning turn for the Cartesia pipeline. Cartesia provides speech only, so this
# reuses OPENAI_API_KEY above.
# TEXT_LLM_MODEL=gpt-4o-mini
