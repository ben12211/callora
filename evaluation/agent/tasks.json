[
  {
    "id": "price_question",
    "turns": [
      {
        "caller": "כמה עולה מונית לנתב\"ג?",
        "expect": {
          "task": "price_question",
          "slots": {
            "price_to": "נתב"
          },
          "says_none": [
            "שקל"
          ]
        }
      }
    ]
  },
  {
    "id": "price_between_two_cities",
    "note": "the cities are enough for the price list: no street asked, no number said by the agent",
    "turns": [
      {
        "caller": "כמה עולה מבני ברק לירושלים?",
        "expect": {
          "task": "price_question",
          "fields": {
            "price_from": "בני ברק",
            "price_to": "ירושלים"
          },
          "says_none": [
            "שקל",
            "רחוב"
          ]
        }
      }
    ]
  },
  {
    "id": "lost_item",
    "note": "\"השארתי תיק במונית\" is a lost item, not a booking",
    "turns": [
      {
        "caller": "השארתי תיק במונית אתמול בערב",
        "expect": {
          "task": "lost_item",
          "slots": {
            "item": "תיק"
          }
        }
      }
    ]
  },
  {
    "id": "complaint_goes_to_a_person",
    "turns": [
      {
        "caller": "אני רוצה להתלונן על הנהג שהיה לי",
        "expect": {
          "task": "complaint",
          "handoff": true
        }
      }
    ]
  },
  {
    "id": "ride_status",
    "turns": [
      {
        "caller": "איפה הנהג שלי? הזמנתי לפני רבע שעה",
        "expect": {
          "task": "ride_status"
        }
      }
    ]
  },
  {
    "id": "a_person_on_request",
    "turns": [
      {
        "caller": "אני רוצה לדבר עם בן אדם",
        "expect": {
          "handoff": true
        }
      }
    ]
  }
]
