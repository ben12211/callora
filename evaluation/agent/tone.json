[
  {
    "id": "tone_frustration_is_not_small_talk",
    "note": "the owner: \"מה נשמע, כמה פעמים אני צריך להגיד לך?\" is a complaint; \"הכל בסדר, כיצד אוכל לעזור?\" is the wrong answer",
    "turns": [
      {
        "caller": "צריך מונית מבני ברק לירושלים, שלושה נוסעים",
        "scripted": {
          "action": "none",
          "task": "book_ride",
          "fields": [
            {
              "slot": "pickup",
              "value": "בני ברק"
            },
            {
              "slot": "destination",
              "value": "ירושלים"
            },
            {
              "slot": "passengers",
              "value": "3"
            }
          ],
          "say": "איפה בבני ברק לאסוף?",
          "asks": [
            "pickup"
          ]
        }
      },
      {
        "caller": "מה נשמע, כמה פעמים אני צריך להגיד לך?",
        "expect": {
          "says_any": [
            "סליחה|צודק|מצטער"
          ],
          "says_none": [
            "הכל טוב|הכל בסדר|במה אפשר לעזור|איך אפשר לעזור|כיצד|הבנתי|כמובן|בשמחה|בהחלט"
          ],
          "ended": false,
          "handoff": false
        }
      }
    ]
  },
  {
    "id": "tone_repeating_is_owned_and_taken",
    "note": "a caller who says it again gets a short sorry and the detail is taken, not asked for again",
